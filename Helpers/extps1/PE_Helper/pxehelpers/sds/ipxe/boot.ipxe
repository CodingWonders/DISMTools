#!ipxe
# Generated by iPXE Menu Designer

set base http://#DT_SDS_IPADDR#
set dt_sds_ver "Discovery" (v0.9)

chain dhcp_option_lookup.ipxe || echo Lookup not loaded

# --- DHCP OPTION QUERY
set dhcp_opt:int32 1
set dhcp_found:int32 0

# --- Console and colours (require CONSOLE_CMD; graphics need CONSOLE_FRAMEBUFFER) ---
console --x 1024 --y 768 --picture ${base}/theme/bg.png --keep ||
colour --rgb 0xffffff 0
colour --rgb 0x004400 1
colour --rgb 0x000000 4
colour --rgb 0x008800 6
cpair --foreground 7 --background 9 0
cpair --foreground 7 --background 9 1
cpair --foreground 0 --background 6 2
cpair --foreground 6 --background 9 3

:start
set menu-page start
menu
item --gap -- Welcome to the
item --gap -- DISMTools System Deployment Services (SDS)
item --gap
item --gap -- For version ${dt_sds_ver}
item --gap -- Powered by iPXE ${version}
item --gap
item --gap -- On machine ${manufacturer} ${product} -- IP ${ip}
item --gap
item --gap
item --gap -- System Deployment
item enterenv Deploy an operating system
item --gap -- System Diagnostics
item printnet Display Network Information
item --gap -- Exit
item pwroff Power Off System
item rstrt Restart System
item exitenv Return to the Boot Manager
choose --default enterenv --timeout 30000 target || goto cancel
goto ${target}

# --- Sub-page: Network Information ---
:sysdiag_netinfo
set menu-page sysdiag_netinfo
menu Network Information
item --gap -- Use this screen to query information about the current
item --gap -- network settings of this device. If something does not look
item --gap -- right, you may need to reconfigure your DHCP settings.
item --gap
item --gap -- The following values are the current network settings applied to this machine:
item --gap
item --gap -- - IP Address      :  ${ip}
item --gap -- - Subnet Mask     :  ${netmask}
item --gap -- - Gateway         :  ${gateway}
item --gap -- - Physical Address:  ${mac}
item --gap
item --gap -- - Host Name       :  ${hostname}
item --gap -- - System UUID     :  ${uuid}
item --gap -- - Domain          :  ${domain}
item --gap
item --gap -- Netbooted using NBP file ${filename}
item --gap
item --gap -- Diagnostic Options:
item --gap
item redhcp Renew the IP address
item rtable Query routing information
item dhcpopt DHCP Server Options
item --gap
item start << Back
choose target || goto start
goto ${target}

# --- Sub-page: DHCP Server Options ---
:dhcp-server-options
set menu-page dhcp-server-options
menu DHCP Server Options
item --gap -- These are the options defined in your DHCP server that
item --gap -- this machine can see:
item --gap

:dhcplookup
# we are not interested in the dhcp message type
iseq ${dhcp_opt} 53 && inc dhcp_opt && goto dhcplookup ||
isset ${net0.dhcp/${dhcp_opt}} || goto dhcpnext
isset ${optname${dhcp_opt}} && set oname ${optname${dhcp_opt}} || set oname Unknown
isset ${opttype${dhcp_opt}} && set otype ${opttype${dhcp_opt}} || set otype hex
item --gap -- ${dhcp_opt} ${oname}: ${net0.dhcp/${dhcp_opt}:${otype}}
inc dhcp_found
:dhcpnext
inc dhcp_opt
iseq ${dhcp_opt} 128 || goto dhcplookup

iseq ${dhcp_found} 0 && item --gap -- No options available ||
item --gap
item sysdiag_netinfo << Back
choose target || goto sysdiag_netinfo
set dhcp_found:int32 0
set dhcp_opt:int32 0
goto ${target}

:cancel
echo Menu cancelled
exit

:failed
echo Boot failed: ${errno}
prompt --timeout 5000 Press any key to return to the menu ||
goto ${menu-page}

:enterenv
echo Entering the DISMTools Preinstallation Environment...
kernel ${base}/wimboot || goto failed
initrd ${base}/winpe/BCD BCD || goto failed
initrd ${base}/winpe/boot.sdi boot.sdi || goto failed
initrd ${base}/winpe/boot.wim boot.wim || goto failed
boot || goto failed

:printnet
goto sysdiag_netinfo

:pwroff
poweroff

:rstrt
reboot

:exitenv
exit

:redhcp
echo Renewing the IP address. Please wait ... && dhcp && prompt Press any key to continue... || echo Address could not be renewed && prompt Press any key to continue... && goto sysdiag_netinfo

:rtable
route && prompt Press any key to continue... && goto sysdiag_netinfo || goto sysdiag_netinfo

:dhcpopt
goto dhcp-server-options
