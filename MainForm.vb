                                msg = "El panel de control del registro de la imagen debe ser cerrado antes de cargar proyectos."
                            Case "FRA"
                                msg = "Le panneau de contrôle du registre des images doit être fermé avant le chargement des projets."
                            Case "PTB", "PTG"
