  <ItemGroup>
    <ProjectReference Include="Tools\BDELib\BDELib.vbproj">
      <Project>{4f91e8cd-220b-4882-9228-b30b7f32c4a9}</Project>
      <Name>BDELib</Name>
    </ProjectReference>
    <ProjectReference Include="Tools\WimgApi.Interop\WimgApi.Interop.csproj">
      <Project>{4acfc225-f102-4c32-873f-b265793bacee}</Project>
      <Name>WimgApi.Interop</Name>
    </ProjectReference>
  </ItemGroup>
  <Import Project="$(MSBuildToolsPath)\Microsoft.VisualBasic.targets" />
  <PropertyGroup>
    <PostBuildEvent>SET DELETELOGDIR="Yes"
SET ISPREVIEW="Yes"
SET GEN_INSTALLER="Yes"
SET COPY_DOCS="Yes"
SET CREATE_SAMPLE_USERDATA="Yes"
SET DT_SDS_COPYUNDI=1
ECHO Generating program structure...
IF EXIST "$(SolutionDir)portable" (
	COPY "$(SolutionDir)portable" . /Y
)
IF EXIST "$(SolutionDir)Helpers\extps1\PE_Helper\Compile.ps1" (
	"\Windows\system32\WindowsPowerShell\v1.0\powershell.exe" -executionpolicy bypass -noprofile -nologo -file "$(SolutionDir)Helpers\extps1\PE_Helper\Compile.ps1"
)
IF NOT EXIST bin (
	md "bin"
	md "bin\exthelpers"
	md "bin\extbatch"
	md "bin\utils"
	md "bin\extps1"
	move "helpers\extbatch\*.*" "bin\extbatch"
	move "helpers\dthelper.bat" "bin"
	move "helpers\extps1\*.*" "bin\extps1"
	md "bin\extps1\PE_Helper"
	xcopy "helpers\extps1\PE_Helper\*.*" "bin\extps1\PE_Helper" /cehyi
	REM System Deployment Services -- copy snponly ipxe if it exists
	IF EXIST "$(SolutionDir)Tools\sdstools\ipxeout\*.efi" (
		ECHO Copying UEFI PXE NBP files...
		XCOPY "$(SolutionDir)Tools\sdstools\ipxeout\*.efi" "bin\extps1\PE_Helper\pxehelpers\sds\ipxe" /cehyi
	)
	REM System Deployment Services -- copy UNDI binaries if we want to and they exist
	IF DEFINED DT_SDS_COPYUNDI IF %25DT_SDS_COPYUNDI%25 EQU 1 (
		ECHO Copying UNDI/BIOS PXE NBP files...
		FOR %25%25A IN (undionly.kpxe ipxe.pxe) DO IF EXIST "$(SolutionDir)Tools\sdstools\ipxeout\%25%25A" COPY /Y "$(SolutionDir)Tools\sdstools\ipxeout\%25%25A" "bin\extps1\PE_Helper\pxehelpers\sds\ipxe\%25%25~nxA"
	)
	IF EXIST "$(SolutionDir)Tools\sdstools\sdsserver\artifacts\" (
		XCOPY "$(SolutionDir)Tools\sdstools\sdsserver\artifacts\*.*" "bin\extps1\PE_Helper\pxehelpers\sds\sdsserver" /CEHYI
	)
	IF EXIST "$(SolutionDir)Tools\sdstools\unpack_server.bat" COPY /y "$(SolutionDir)Tools\sdstools\unpack_server.bat" "bin\extps1\PE_Helper\pxehelpers\sds\sdsserver\unpack_server.bat"
	IF EXIST "$(SolutionDir)helpers\extps1\PE_Helper\Compile.ps1" (
		:: Compile the script with CTT's compilation script (license in source code and About section)
		ECHO Invoking pre-processing...
		COPY "$(SolutionDir)helpers\extps1\PE_Helper\Compile.ps1" "$(TargetDir)bin\extps1\PE_Helper\Compile.ps1"
		COPY "$(SolutionDir)helpers\extps1\PE_Helper\tools\Invoke-Preprocessing.ps1" "$(TargetDir)bin\extps1\PE_Helper\tools\Invoke-Preprocessing.ps1"
		"\Windows\system32\WindowsPowerShell\v1.0\powershell.exe" -executionpolicy bypass -noprofile -nologo -file "$(TargetDir)bin\extps1\PE_Helper\Compile.ps1"
		DEL "$(TargetDir)bin\extps1\PE_Helper\Compile.ps1" /F /Q
		DEL "$(TargetDir)bin\extps1\PE_Helper\tools\Invoke-Preprocessing.ps1" /F /Q
	)
	IF EXIST HELPERS (
		rd HELPERS /s /q
	)
	IF EXIST "$(ProjectDir)language" XCOPY "$(ProjectDir)language\*.ini" bin\language /cehyi
) ELSE (
	echo A bin folder already exists
)
IF EXIST "$(SolutionDir)7z" (
	XCOPY "$(SolutionDir)7z\amd64\*" "$(TargetDir)bin\utils\x64" /cehyi
	XCOPY "$(SolutionDir)7z\i386\*" "$(TargetDir)bin\utils\x86" /cehyi
)
IF NOT EXIST logs (
	md logs
) ELSE (
	IF %25DELETELOGDIR%25=="Yes" (
		echo A log directory already exists. Deleting log files...
		del logs\* /f /q
	) ELSE (
		echo A log directory already exists
		echo If you want to delete log files, set the DELETELOGDIR post-build variable to "Yes"
	)
)
IF NOT EXIST scratch (
	md scratch
)
:: Copy the Internet Explorer browser emulation registry file to the program directory
copy /y "$(SolutionDir)Tools\DT_IEConfig.reg" "DT_IEConfig.reg"

:: Copy registry file for ADK installations
copy /y "$(SolutionDir)Tools\DT_WinADK.reg" "DT_WinADK.reg"

IF EXIST "$(SolutionDir)Tools\UnpEax-Bin\UnpEax.exe" (
	md "Tools\UnpEax"
	copy /y "$(SolutionDir)Tools\UnpEax-Bin\UnpEax.exe" "Tools\UnpEax\UnpEax.exe"
)

:: Copy UnattendGen
IF EXIST "$(SolutionDir)Tools\UnattendGen" (
	md "Tools\UnattendGen"
	xcopy "$(SolutionDir)Tools\UnattendGen\*" "Tools\UnattendGen" /cehyi
)

:: Copy DynaViewer
IF EXIST "$(SolutionDir)Tools\DynaViewer\out\*.exe" (
	md "Tools\DynaViewer"
	xcopy "$(SolutionDir)Tools\DynaViewer\out\*.exe" "Tools\DynaViewer" /cehyi
)

:: Copy themes over to bin directory
IF EXIST "$(SolutionDir)Utilities\ThemeUtilities\ThemeFiles\*.ini" (
	md "bin\themes"
	xcopy "$(SolutionDir)Utilities\ThemeUtilities\ThemeFiles\*.ini" "bin\themes" /cehyi
)

:: Copy Theme Designer
IF EXIST "$(SolutionDir)Tools\DT_ThemeDesigner\out\*.exe" (
	xcopy "$(SolutionDir)Tools\DT_ThemeDesigner\out\*.*" "Tools\ThemeDesigner" /cehyi
	del "Tools\ThemeDesigner\*.zip" /F /S /Q
)

:: Copy Starter Script Editor
IF EXIST "$(SolutionDir)Tools\StarterScriptEditor\out\*.exe" (
	xcopy "$(SolutionDir)Tools\StarterScriptEditor\out\*.*" "Tools\StarterScriptEditor" /cehyi
	del "Tools\StarterScriptEditor\*.zip" /F /S /Q
)

:: Copy Driver Pack Creator
IF EXIST "$(SolutionDir)Tools\DrvPakCreator\out\*.exe" (
	xcopy "$(SolutionDir)Tools\DrvPakCreator\out\*.*" "Tools\DrvPakCreator" /cehyi
	del "Tools\DrvPakCreator\*.zip" /F /S /Q
)

:: Copy PE Helper Main Menu
IF EXIST "$(SolutionDir)Helpers\extps1\PE_Helper\tools\PEHelperMainMenu\out\*.exe" (
	xcopy "$(SolutionDir)Helpers\extps1\PE_Helper\tools\PEHelperMainMenu\out\*.*" "bin\extps1\PE_Helper\tools\MainMenu" /CEHYI
)

:: Copy BDE-GUI utilities
IF EXIST "$(SolutionDir)Helpers\extps1\PE_Helper\tools\BDE-GUI" (
	MD "bin\extps1\PE_Helper\tools\BDE-GUI"
	FOR %25%25A IN (ps1 bat cmd png) DO xcopy "$(SolutionDir)Helpers\extps1\PE_Helper\tools\BDE-GUI\*.%25%25A" "bin\extps1\PE_Helper\tools\BDE-GUI" /CEHYI
)

:: Copy Tour
IF EXIST "$(SolutionDir)tour" (
	xcopy "$(SolutionDir)tour\*.*" "$(TargetDir)docs\tour" /cehyi
	IF EXIST "$(TargetDir)docs\tour\.git" (rd "$(TargetDir)docs\tour\.git" /s /q)
	IF EXIST "$(TargetDir)docs\tour\.vscode" (rd "$(TargetDir)docstour\.vscode" /s /q)
	IF EXIST "$(TargetDir)docs\tour\.git*" (del "$(TargetDir)docs\tour\.git*" /f /s /q)
)

IF NOT EXIST AutoUnattend (
	md AutoUnattend
	copy /y "$(SolutionDir)Elements\AutoUnattend\*.xml" AutoUnattend
	IF EXIST "$(ProjectDir)Elements\AutoUnattend\StarterScripts" (
		xcopy "$(ProjectDir)Elements\AutoUnattend\StarterScripts\*.dtss" AutoUnattend\StarterScripts /cehyi
	)
)

:: Copy our cool facts
IF EXIST "$(SolutionDir)Elements\InfinityHome\facts.xml" (
	copy /y "$(SolutionDir)Elements\InfinityHome\facts.xml" bin\facts.xml
)

IF %25ISPREVIEW%25=="Yes" (
	echo You will be running a preview release, which may not be ready for production. You may experience more bugs and less stability. Please switch to a stable release whenever possible.
)
IF NOT EXIST videos (
	md videos
	copy /y "$(SolutionDir)Videos\videoplay.html" "videos\videoplay_tmp.html"
)
IF %25COPY_DOCS%25=="Yes" (
	echo Copying help documentation...
	xcopy "$(ProjectDir)docs\*" "$(TargetDir)docs" /cehyi
	break &gt; "$(TargetDir)docs\NOTASITE"
)
IF %25CREATE_SAMPLE_USERDATA%25=="Yes" (
	echo Creating sample userdata structure...
	IF NOT EXIST "userdata" (md "userdata")
	FOR %25%25A IN (dtpe_backgrounds themes starter_scripts sse_config_rules) DO (
		IF NOT EXIST "userdata\%25%25A" (md "userdata\%25%25A")
	)
)
IF EXIST "$(SolutionDir)Tools\AutoReloadService\out" (
	echo Copying AutoReloadService...
	IF NOT EXIST "AutoReload" MD "AutoReload"
	copy /y "$(SolutionDir)Tools\AutoReloadService\out\*.*" "AutoReload"
)
IF %25GEN_INSTALLER%25=="Yes" (
	echo The technology used for creating the installer is subject to a license. Refer to the "LICENSE.TXT" file in the "$(SolutionDir)Installer" directory for more information
	:: Workaround for DLLs not copying
	"\Windows\system32\WindowsPowerShell\v1.0\powershell.exe" -executionpolicy bypass -noprofile -nologo -file "$(SolutionDir)CheckMissingDLLs.ps1"
	echo Copying program files...
	IF EXIST "$(SolutionDir)Installer\files" (rd "$(SolutionDir)Installer\files" /s /q)
	IF NOT EXIST "$(SolutionDir)Installer\files" (md "$(SolutionDir)Installer\files")
	XCOPY "$(TargetDir)*.*" "$(SolutionDir)Installer\files" /cehyi
	IF EXIST "$(SolutionDir)Installer\files\VS*.tmp" (del "$(SolutionDir)Installer\files\VS*.tmp" /f /q)
	IF EXIST "$(SolutionDir)Installer\iscc.exe" (
		echo Building the installer...
		"$(SolutionDir)Installer\iscc.exe" "$(SolutionDir)Installer\dt.iss"
	) ELSE (
		echo Warning: the installer compiler could not be found. Deleting temporary setup files...
		rd "$(SolutionDir)Installer\files" /s /q
	)
)</PostBuildEvent>
  </PropertyGroup>
  <PropertyGroup>
    <PreBuildEvent>ECHO Deleting bin folder...
IF EXIST "portable" (
	ATTRIB portable -h
	DEL portable
)
IF EXIST bin (
	rd bin /s /q
)
IF EXIST temp (
	rd temp /s /q
)
IF EXIST scratch (
	rd scratch /s /q
)
IF EXIST docs (
	rd docs /s /q
)

IF EXIST videos (
	rd videos /s /q
)

IF EXIST AutoUnattend (
	rd AutoUnattend /s /q
)

IF EXIST videos.xml (del videos.xml)
IF EXIST videos.xml.old (del videos.xml.old)

IF EXIST tools (
	rd tools /s /q
)

IF EXIST "report.html" (del "report.html")</PreBuildEvent>
  </PropertyGroup>
  <!-- To modify your build process, add your task inside one of the targets below and uncomment it. 
       Other similar extension points exist, see Microsoft.Common.targets.
  <Target Name="BeforeBuild">
  </Target>
  <Target Name="AfterBuild">
  </Target>
  -->
  <Import Project="packages\Scintilla5.NET.6.1.2\build\scintilla5.net.targets" Condition="Exists('packages\Scintilla5.NET.6.1.2\build\scintilla5.net.targets')" />
  <Target Name="EnsureNuGetPackageBuildImports" BeforeTargets="PrepareForBuild">
    <PropertyGroup>
      <ErrorText>Este proyecto hace referencia a los paquetes NuGet que faltan en este equipo. Use la restauración de paquetes NuGet para descargarlos. Para obtener más información, consulte http://go.microsoft.com/fwlink/?LinkID=322105. El archivo que falta es {0}.</ErrorText>
    </PropertyGroup>
    <Error Condition="!Exists('packages\Scintilla5.NET.6.1.2\build\scintilla5.net.targets')" Text="$([System.String]::Format('$(ErrorText)', 'packages\Scintilla5.NET.6.1.2\build\scintilla5.net.targets'))" />
  </Target>
</Project>